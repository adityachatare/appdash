# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/appdash

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# 32-byte hex key used to encrypt stored Firebase service-account private keys.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Anthropic (AI notification generation)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
